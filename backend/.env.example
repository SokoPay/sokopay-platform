# ---------------------------------------------------------------------------
# SokoPay backend environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).
# Every secret is injected from the environment — nothing secret lives in code.
# ---------------------------------------------------------------------------

# Which settings module to load: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django core
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-in-every-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Required in production.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://sokopay:localdev_only@localhost:5432/sokopay

# Redis (cache, rate limiting, OTP store, Celery broker)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# LICENCE GATE — the switch that controls which features are legally enabled.
# One of: PSP_STANDARD | PSP_MEDIUM | PSP_ENHANCED | EMI | DEMI
# SokoPay launches at PSP_STANDARD. Raise this ONLY when BoG grants the licence.
# Changing it unlocks exactly the capabilities that licence permits — nothing more.
# ---------------------------------------------------------------------------
SOKOPAY_ACTIVE_LICENCE=PSP_STANDARD

# Field-level encryption key for PII at rest (Ghana Card numbers, bank accounts).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=replace-me

# Enhanced PSP partner (the rail SokoPay connects to under PSP Standard/Medium).
# Values supplied by Korba or Nsano once the agreement is signed.
RAIL_PROVIDER=mock                       # mock | korba | nsano
RAIL_API_BASE_URL=
RAIL_API_KEY=
RAIL_WEBHOOK_SECRET=

# SMS provider: console (dev) | hubtel | mnotify
SMS_PROVIDER=console
SMS_SENDER_ID=SokoPay
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
MNOTIFY_API_KEY=

# Observability (optional in dev)
SENTRY_DSN=
