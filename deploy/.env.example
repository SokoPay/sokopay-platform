# =============================================================================
# SokoPay server settings: copy to deploy/.env on the server, fill in, chmod 600.
# NEVER commit .env, never email or WhatsApp it. Generate secrets with
# scripts/make-secrets.sh (it fills the CHANGE_ME values for you).
# =============================================================================

# --- Which environment -------------------------------------------------------
# staging = production hardening + the mock payment partner (until a real partner is
#           certified). Shows a TEST ENVIRONMENT banner. Demo data only.
# prod    = real partners only; refuses to start with any mock (see docs).
DJANGO_SETTINGS_MODULE=config.settings.staging

# --- Domain and HTTPS ----------------------------------------------------------
# The public name of this server. Its DNS A record must point at the droplet's IP.
# No domain yet? Use <ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
SOKOPAY_DOMAIN=sokopay.theagbeko.com
# Let's Encrypt expiry notices
ACME_EMAIL=you@example.com
# Hosts Django answers for (the domain, plus localhost for health checks).
ALLOWED_HOSTS=sokopay.theagbeko.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://sokopay.theagbeko.com
# QR codes and payment links point here (the same domain).
QR_BASE_URL=https://sokopay.theagbeko.com
# The one reverse proxy in front (the droplet's Nginx/Caddy, or SokoPay's own Caddy)
TRUSTED_PROXY_COUNT=1
# Local port the droplet's reverse proxy forwards to (127.0.0.1 only). Pick one no other
# project uses: check with  sudo ss -ltnp | grep 8100
SOKOPAY_WEB_PORT=8100

# --- Secrets (generated by scripts/make-secrets.sh) ---------------------------
SECRET_KEY=CHANGE_ME
# encrypts Ghana Card numbers; losing it = unreadable data
FIELD_ENCRYPTION_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
USSD_SHARED_SECRET=CHANGE_ME
RAIL_WEBHOOK_SECRET=CHANGE_ME

# --- Database ------------------------------------------------------------------
# Which optional services to run:
#   localdb        PostgreSQL in Docker for SokoPay (separate from other projects' databases)
#   caddy          SokoPay's own HTTPS proxy, ONLY if nothing else on the droplet uses 80/443
# Shared droplet with Nginx/Caddy already running (usual):  COMPOSE_PROFILES=localdb
# SokoPay alone on the droplet:                             COMPOSE_PROFILES=localdb,caddy
COMPOSE_PROFILES=localdb
DATABASE_URL=postgres://sokopay:CHANGE_ME@db:5432/sokopay
# Option B: DigitalOcean Managed PostgreSQL. Set COMPOSE_PROFILES= (empty) and paste the
# connection string from the DO control panel, keeping sslmode=require:
# DATABASE_URL=postgres://doadmin:<password>@<host>:25060/defaultdb?sslmode=require

# --- Redis (cache, rate limits, one-time codes, task queue) --------------------
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- Licence --------------------------------------------------------------------
# DEMI switches every feature on for a full test. In real production this must match
# the licence actually granted by the Bank of Ghana.
SOKOPAY_ACTIVE_LICENCE=DEMI

# --- Partners -------------------------------------------------------------------
# Staging defaults: mock payment partner, mock identity check, console SMS/push.
ALLOW_MOCK_INTEGRATIONS=True
RAIL_PROVIDER=mock
KYC_IDENTITY_PROVIDER=mock
# SMS for one-time codes (app sign-in, PIN reset, portal 2FA) and alerts.
# console = codes only appear in: docker compose logs web
# arkesel = real SMS through Arkesel (needs ARKESEL_API_KEY; the server won't start without it)
SMS_PROVIDER=console
# PUSH_PROVIDER: console, or fcm once Firebase is configured
PUSH_PROVIDER=console
# From the Arkesel dashboard (SMS API key). Never commit or share it.
ARKESEL_API_KEY=
# Approved Arkesel sender ID, max 11 characters
ARKESEL_SENDER_ID=MySokoApp
# True = Arkesel accepts but doesn't deliver or bill (test the integration for free)
ARKESEL_SANDBOX=False
# How long an SMS code stays valid, in seconds (600 = 10 minutes)
OTP_TTL_SECONDS=600
# Web portal 2FA by SMS code (authenticator apps and backup codes keep working too)
PORTAL_2FA_SMS=True
# Invite links (set your portal password) sent by SMS stay valid this many hours
PORTAL_INVITE_TTL_HOURS=72
# Public "Register your business" page at /dashboard/register/ (False hides it)
MERCHANT_SELF_SIGNUP=True
# Real push (optional): PUSH_PROVIDER=fcm, FCM_PROJECT_ID=, FCM_SERVICE_ACCOUNT_FILE=/app/secrets/fcm.json

# --- AI insights (optional, OFF by default) ---------------------------------------
# The AI only ever receives anonymised totals through fixed reports (no names, phones,
# ID numbers, references); questions and answers are scrubbed both ways; every use is
# logged. Record this external processing in your Data Protection Commission register
# before switching it on with real customers.
AI_PROVIDER=off
# From console.anthropic.com. Never commit or share it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# The "Ask the AI" box (the daily briefing works without it)
AI_CHAT_ENABLED=False
AI_CHAT_PER_HOUR=20
# Tokens per day across all staff; over it, AI requests are refused until midnight
AI_DAILY_TOKEN_BUDGET=300000

# --- Monitoring (optional) ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
